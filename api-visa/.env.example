# Copy to .env (which git ignores) and replace the values. Never commit real secrets.
# Passwords: letters and numbers only (they go inside a URL). Generate with: openssl rand -hex 24
MONGO_ROOT_USERNAME=api_visa
MONGO_ROOT_PASSWORD=change-me

# Key for the X-Admin-Key header on /admin/** (min. 32 chars). Empty = /admin closed.
# Generate with: openssl rand -hex 32
ADMIN_API_KEY=

# Optional: run the collection inside the app (Spring cron, UTC). "-" = off.
# Example, every day at 05:00: 0 0 5 * * *
COLLECTION_CRON=-

# Optional: e-mail alert when a collection fails. Without these, failures only go to the log.
# Brevo: SMTP_HOST=smtp-relay.brevo.com, SMTP_PORT=587, user/password from Brevo > SMTP & API.
NOTIFICATION_EMAIL_TO=
NOTIFICATION_EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Optional: host ports, if 8080/27017 are already in use.
# API_PORT=8080
# MONGO_PORT=27017
